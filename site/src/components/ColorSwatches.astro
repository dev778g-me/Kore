---
import {
    tailwindFamilies,
    tailwindShades,
    radixScales,
} from "../data/kore-colors";

interface Props {
    mode: "tailwind" | "radix";
}

const { mode } = Astro.props;

const toHexString = (hex: string) => `0xFF${hex.slice(1).toUpperCase()}`;

const inkFor = (hex: string) => {
    const n = parseInt(hex.slice(1), 16);
    const r = (n >> 16) & 255;
    const g = (n >> 8) & 255;
    const b = n & 255;
    return (0.299 * r + 0.587 * g + 0.114 * b) / 255 > 0.6
        ? "#000"
        : "#fff";
};

const hoverFor = (hex: string) => (inkFor(hex) === "#000" ? "#fff" : "#000");
---

{mode === "tailwind" ? (
    <div class="swatches not-content" data-swatches="tailwind">
        {Object.entries(tailwindFamilies).map(([name, shades]) => (
            <div class="swatch-row">
                <p class="swatch-label">{name}</p>
                <div class="swatch-strip">
                    {shades.map((hex, i) => (
                        <button
                            type="button"
                            class="swatch"
                            data-hex={toHexString(hex)}
                            data-label={name}
                            data-step={tailwindShades[i]}
                            style={`background-color: ${hex}; --swatch-ink: ${inkFor(hex)}; --swatch-hover: ${hoverFor(hex)};`}
                            title={`${name} ${tailwindShades[i]} — ${toHexString(hex)}`}
                            aria-label={`Copy ${name} ${tailwindShades[i]} ${toHexString(hex)}`}
                        />
                    ))}
                </div>
            </div>
        ))}
        <div class="swatch-toast" role="status"></div>
    </div>
) : (
    <div class="swatches not-content" data-swatches="radix">
        {Object.entries(radixScales).map(([name, scale]) => (
            <div class="swatch-row">
                <p class="swatch-label">{name}</p>
                <div class="swatch-strip">
                    {scale.dark.map((darkHex, k) => (
                        <button
                            type="button"
                            class="swatch"
                            data-light={toHexString(scale.light[k])}
                            data-dark={toHexString(darkHex)}
                            data-bg-light={scale.light[k]}
                            data-bg-dark={darkHex}
                            data-ink-light={inkFor(scale.light[k])}
                            data-ink-dark={inkFor(darkHex)}
                            data-hover-light={hoverFor(scale.light[k])}
                            data-hover-dark={hoverFor(darkHex)}
                            data-label={`${name} step ${k + 1}`}
                            data-step={k + 1}
                            style={`background-color: ${darkHex}; --swatch-ink: ${inkFor(darkHex)}; --swatch-hover: ${hoverFor(darkHex)};`}
                            title={`${name} step ${k + 1} — ${toHexString(darkHex)}`}
                            aria-label={`Copy ${name} step ${k + 1} ${toHexString(darkHex)}`}
                        />
                    ))}
                </div>
            </div>
        ))}
        <div class="swatch-toast" role="status"></div>
    </div>
)}

<script>
    // hex8 is "0xFFRRGGBB"
    const luminance = (hex8: string) => {
        const r = parseInt(hex8.slice(4, 6), 16) / 255;
        const g = parseInt(hex8.slice(6, 8), 16) / 255;
        const b = parseInt(hex8.slice(8, 10), 16) / 255;
        return 0.2126 * r + 0.7152 * g + 0.0722 * b;
    };

    const CHECK_SVG =
        '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>';

    const paintRadix = () => {
        const dark = document.documentElement.dataset.theme !== "light";
        document
            .querySelectorAll<HTMLButtonElement>(
                '[data-swatches="radix"] .swatch',
            )
            .forEach((box) => {
                box.dataset.hex = dark ? box.dataset.dark! : box.dataset.light!;
                box.style.backgroundColor = dark
                    ? box.dataset.bgDark!
                    : box.dataset.bgLight!;
                box.style.setProperty(
                    "--swatch-ink",
                    dark ? box.dataset.inkDark! : box.dataset.inkLight!,
                );
                box.style.setProperty(
                    "--swatch-hover",
                    dark ? box.dataset.hoverDark! : box.dataset.hoverLight!,
                );
                box.title = `${box.dataset.label} — ${box.dataset.hex}`;
            });
    };

    const timers = new WeakMap<HTMLElement, number>();
    const toastTimers = new WeakMap<HTMLElement, number>();

    const showToast = (box: HTMLButtonElement, snippet: string) => {
        const toast = box
            .closest(".swatches")
            ?.querySelector<HTMLElement>(".swatch-toast");
        if (!toast) return;
        toast.textContent = `Copied ${snippet}`;
        toast.classList.add("on");
        clearTimeout(toastTimers.get(toast));
        toastTimers.set(
            toast,
            window.setTimeout(() => toast.classList.remove("on"), 1600),
        );
    };

    const flashCopied = (box: HTMLButtonElement, hex: string) => {
        clearTimeout(timers.get(box));
        box.querySelector("[data-copied]")?.remove();

        const mark = document.createElement("span");
        mark.dataset.copied = "true";
        mark.setAttribute("aria-hidden", "true");
        mark.style.color = luminance(hex) > 0.5 ? "#000" : "#fff";
        mark.innerHTML = CHECK_SVG;
        box.appendChild(mark);

        timers.set(
            box,
            window.setTimeout(() => mark.remove(), 800),
        );
    };

    document
        .querySelectorAll<HTMLButtonElement>(".swatches .swatch")
        .forEach((box) => {
            box.addEventListener("click", async () => {
                const hex = box.dataset.hex ?? "";
                if (!hex) return;
                const snippet = `Color(${hex})`;
                try {
                    await navigator.clipboard.writeText(snippet);
                } catch {
                    const ta = document.createElement("textarea");
                    ta.value = snippet;
                    ta.style.position = "fixed";
                    ta.style.opacity = "0";
                    document.body.appendChild(ta);
                    ta.select();
                    document.execCommand("copy");
                    ta.remove();
                }
                flashCopied(box, hex);
                showToast(box, snippet);
            });
        });

    paintRadix();
    new MutationObserver(paintRadix).observe(document.documentElement, {
        attributes: true,
        attributeFilter: ["data-theme"],
    });
</script>

<style>
    .swatches {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        margin: 1rem 0;
    }
    /* Beat Starlight's `* + *` margin-top rule (also covered by .not-content) */
    .swatches .swatch-row,
    .swatches .swatch-strip,
    .swatches .swatch {
        margin-top: 0;
    }
    .swatch-row {
        padding: 0.25rem 0;
    }
    .swatches .swatch-label {
        font-size: 0.75rem;
        font-weight: 600;
        margin: 0 0 0.375rem;
    }
    .swatch-strip {
        display: grid;
        grid-template-columns: repeat(11, 1fr);
        gap: 0.25rem;
    }
    [data-swatches="radix"] .swatch-strip {
        grid-template-columns: repeat(12, 1fr);
    }
    .swatches .swatch {
        appearance: none;
        border: 0;
        padding: 0;
        margin: 0;
        width: 100%;
        aspect-ratio: 1 / 1;
        height: auto;
        border-radius: 0.5rem;
        cursor: pointer;
        position: relative;
        overflow: hidden;
        color: var(--swatch-ink, #fff);
        transition: transform 0.12s ease;
    }
    .swatches .swatch::before {
        content: "";
        position: absolute;
        inset: 0;
        background: var(--swatch-hover, #000);
        opacity: 0;
        transition: opacity 0.18s ease;
    }
    .swatches .swatch::after {
        content: attr(data-step);
        position: absolute;
        inset: 0;
        z-index: 1;
        display: grid;
        place-items: center;
        color: var(--swatch-ink, #fff);
        font-size: 0.58rem;
        font-weight: 600;
        line-height: 1;
        opacity: 0;
        transform: translateY(3px);
        pointer-events: none;
        transition:
            opacity 0.18s ease,
            transform 0.18s ease;
    }
    .swatch:hover::before {
        opacity: 0.14;
    }
    .swatch:hover::after,
    .swatch:focus-visible::after {
        opacity: 1;
        transform: none;
    }
    .swatch:has([data-copied])::after {
        opacity: 0;
    }
    .swatch:active {
        transform: scale(0.95);
    }
    .swatch:focus-visible {
        outline: 2px solid currentColor;
        outline-offset: 2px;
    }

    /* The check mark is created in JS, so it needs :global() */
    .swatch :global([data-copied]) {
        position: absolute;
        inset: 0;
        z-index: 2;
        display: grid;
        place-items: center;
        pointer-events: none;
        animation: copied-fade 0.8s ease forwards;
    }
    .swatch :global([data-copied] svg) {
        width: 50%;
        height: 50%;
    }

    .swatch-toast {
        position: fixed;
        left: 50%;
        bottom: 1.5rem;
        z-index: 100;
        transform: translate(-50%, 120px);
        padding: 0.7rem 1.15rem;
        border-radius: 99px;
        background: var(--kore-on-background);
        color: var(--kore-background);
        font-size: 0.85rem;
        font-weight: 500;
        pointer-events: none;
        transition: transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .swatch-toast.on {
        transform: translate(-50%, 0);
    }

    @keyframes copied-fade {
        0% {
            opacity: 0;
        }
        15%,
        70% {
            opacity: 1;
        }
        100% {
            opacity: 0;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .swatches .swatch,
        .swatches .swatch::before,
        .swatches .swatch::after,
        .swatch-toast {
            transition: none;
        }
        .swatch :global([data-copied]) {
            animation: none;
        }
    }
</style>
