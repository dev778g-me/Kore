---
import { tailwindFamilies, radixScales } from "../data/kore-colors";

interface Props {
    mode: "tailwind" | "radix";
}

const { mode } = Astro.props;

const toHexString = (hex: string) => `0xFF${hex.slice(1).toUpperCase()}`;
---

{mode === "tailwind" ? (
    <div class="swatches not-content" data-swatches="tailwind">
        {Object.entries(tailwindFamilies).map(([name, shades]) => (
            <div class="swatch-row">
                <p class="swatch-label">{name}</p>
                <div class="swatch-strip">
                    {shades.map((hex) => (
                        <button
                            type="button"
                            class="swatch"
                            data-hex={toHexString(hex)}
                            data-label={name}
                            style={`background-color: ${hex};`}
                            title={`${name} — ${toHexString(hex)}`}
                            aria-label={`Copy ${name} ${toHexString(hex)}`}
                        />
                    ))}
                </div>
            </div>
        ))}
    </div>
) : (
    <div class="swatches not-content" data-swatches="radix">
        {Object.entries(radixScales).map(([name, scale]) => (
            <div class="swatch-row">
                <p class="swatch-label">{name}</p>
                <div class="swatch-strip">
                    {scale.dark.map((darkHex, k) => (
                        <button
                            type="button"
                            class="swatch"
                            data-light={toHexString(scale.light[k])}
                            data-dark={toHexString(darkHex)}
                            data-bg-light={scale.light[k]}
                            data-bg-dark={darkHex}
                            data-label={`${name} step ${k + 1}`}
                            style={`background-color: ${darkHex};`}
                            title={`${name} step ${k + 1}`}
                            aria-label={`Copy ${name} step ${k + 1}`}
                        />
                    ))}
                </div>
            </div>
        ))}
    </div>
)}

<script>
    // hex8 is "0xFFRRGGBB"
    const luminance = (hex8: string) => {
        const r = parseInt(hex8.slice(4, 6), 16) / 255;
        const g = parseInt(hex8.slice(6, 8), 16) / 255;
        const b = parseInt(hex8.slice(8, 10), 16) / 255;
        return 0.2126 * r + 0.7152 * g + 0.0722 * b;
    };

    const CHECK_SVG =
        '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>';

    const paintRadix = () => {
        const dark = document.documentElement.dataset.theme !== "light";
        document
            .querySelectorAll<HTMLButtonElement>(
                '[data-swatches="radix"] .swatch',
            )
            .forEach((box) => {
                box.dataset.hex = dark ? box.dataset.dark! : box.dataset.light!;
                box.style.backgroundColor = dark
                    ? box.dataset.bgDark!
                    : box.dataset.bgLight!;
                box.title = `${box.dataset.label} — ${box.dataset.hex}`;
            });
    };

    const timers = new WeakMap<HTMLElement, number>();

    const flashCopied = (box: HTMLButtonElement, hex: string) => {
        clearTimeout(timers.get(box));
        box.querySelector("[data-copied]")?.remove();

        const mark = document.createElement("span");
        mark.dataset.copied = "true";
        mark.setAttribute("aria-hidden", "true");
        mark.style.color = luminance(hex) > 0.5 ? "#000" : "#fff";
        mark.innerHTML = CHECK_SVG;
        box.appendChild(mark);

        timers.set(
            box,
            window.setTimeout(() => mark.remove(), 800),
        );
    };

    document
        .querySelectorAll<HTMLButtonElement>(".swatches .swatch")
        .forEach((box) => {
            box.addEventListener("click", async () => {
                const hex = box.dataset.hex ?? "";
                if (!hex) return;
                const snippet = `Color(${hex})`;
                try {
                    await navigator.clipboard.writeText(snippet);
                } catch {
                    const ta = document.createElement("textarea");
                    ta.value = snippet;
                    ta.style.position = "fixed";
                    ta.style.opacity = "0";
                    document.body.appendChild(ta);
                    ta.select();
                    document.execCommand("copy");
                    ta.remove();
                }
                flashCopied(box, hex);
            });
        });

    paintRadix();
    new MutationObserver(paintRadix).observe(document.documentElement, {
        attributes: true,
        attributeFilter: ["data-theme"],
    });
</script>

<style>
    .swatches {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        margin: 1rem 0;
    }
    /* Beat Starlight's `* + *` margin-top rule (also covered by .not-content) */
    .swatches .swatch-row,
    .swatches .swatch-strip,
    .swatches .swatch {
        margin-top: 0;
    }
    .swatch-row {
        padding: 0.25rem 0;
    }
    .swatches .swatch-label {
        font-size: 0.75rem;
        font-weight: 600;
        margin: 0 0 0.375rem;
    }
    .swatch-strip {
        display: grid;
        grid-template-columns: repeat(11, 1fr);
        gap: 0.25rem;
    }
    [data-swatches="radix"] .swatch-strip {
        grid-template-columns: repeat(12, 1fr);
    }
    .swatches .swatch {
        appearance: none;
        border: 0;
        padding: 0;
        margin: 0;
        width: 100%;
        aspect-ratio: 1 / 1;
        height: auto;
        border-radius: 0.5rem;
        cursor: pointer;
        position: relative;
        overflow: hidden;
        transition:
            transform 0.12s ease,
            filter 0.12s ease;
    }
    .swatch:hover {
        filter: brightness(1.08);
    }
    .swatch:active {
        transform: scale(0.95);
    }
    .swatch:focus-visible {
        outline: 2px solid currentColor;
        outline-offset: 2px;
    }

    /* The check mark is created in JS, so it needs :global() */
    .swatch :global([data-copied]) {
        position: absolute;
        inset: 0;
        display: grid;
        place-items: center;
        pointer-events: none;
        animation: copied-fade 0.8s ease forwards;
    }
    .swatch :global([data-copied] svg) {
        width: 50%;
        height: 50%;
    }

    @keyframes copied-fade {
        0% {
            opacity: 0;
        }
        15%,
        70% {
            opacity: 1;
        }
        100% {
            opacity: 0;
        }
    }
</style>
