---
// Header social icons override: GitHub + Create + Docs + Changelog links in the top bar.
const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";
const docsRoots = [
    "/getting-started",
    "/components",
    "/guides",
    "/reference",
];
const isDocs = docsRoots.some(
    (root) => pathname === root || pathname.startsWith(`${root}/`),
);
const isCreate = pathname === "/create";
const isChangelog = pathname === "/changelog";
---

<a
    href="https://github.com/dev778g-me/Kore"
    rel="me"
    class="sl-flex header-icon"
    aria-label="GitHub"
>
    <svg
        aria-hidden="true"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="currentColor"
    >
        <path d="M12 .5A11.5 11.5 0 0 0 8.36 22.9c.58.11.79-.25.79-.56v-2.13c-3.22.7-3.9-1.38-3.9-1.38-.53-1.35-1.29-1.7-1.29-1.7-1.05-.72.08-.71.08-.71 1.17.08 1.79 1.2 1.79 1.2 1.04 1.78 2.72 1.26 3.38.96.11-.75.41-1.26.74-1.55-2.57-.29-5.27-1.29-5.27-5.73 0-1.27.45-2.3 1.2-3.11-.12-.29-.52-1.47.11-3.07 0 0 .98-.31 3.2 1.19a11.05 11.05 0 0 1 5.82 0c2.22-1.5 3.2-1.19 3.2-1.19.63 1.6.23 2.78.11 3.07.75.81 1.2 1.84 1.2 3.11 0 4.45-2.71 5.43-5.29 5.72.42.36.79 1.07.79 2.16v3.2c0 .31.21.68.8.56A11.5 11.5 0 0 0 12 .5Z" />
    </svg>
</a>
{
    !isCreate && (
        <a href="/create/" class="header-link">
            Create
        </a>
    )
}
{
    !isDocs && (
        <a href="/getting-started/overview/" class="header-link">
            Docs
        </a>
    )
}
{
    !isChangelog && (
        <a href="/changelog/" class="header-link">
            Changelog
        </a>
    )
}

<style>
    .header-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2.5rem;
        height: 2.5rem;
        padding: 0;
        border-radius: 999px;
        color: var(--kore-primary);
        transition:
            background 0.2s,
            color 0.2s,
            transform 0.15s;
    }
    .header-icon:active {
        transform: scale(0.96);
    }
    .header-icon:hover {
        background: color-mix(
            in srgb,
            var(--kore-primary) 10%,
            transparent
        );
        color: var(--kore-primary);
    }
    .header-icon:focus-visible,
    .header-link:focus-visible {
        outline: 2px solid var(--kore-primary);
        outline-offset: 2px;
    }
    .header-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 2.5rem;
        padding-inline: 0.75rem;
        border-radius: 0.6rem;
        color: var(--kore-on-background);
        font-size: 0.875rem;
        font-weight: 600;
        text-decoration: none;
        white-space: nowrap;
        transition:
            background 0.2s,
            transform 0.15s;
    }
    .header-link:active {
        transform: scale(0.96);
    }
    .header-link:hover {
        background: color-mix(
            in srgb,
            var(--kore-on-background) 8%,
            transparent
        );
        color: var(--kore-on-background);
    }
</style>
