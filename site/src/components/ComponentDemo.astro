---
interface Props {
    sample?: string;
    title?: string;
    height?: string;
    /** Set for the above-the-fold demo so it boots immediately. */
    eager?: boolean;
}
const { sample, title = "Code", height = "220px", eager = false } = Astro.props;
const src = sample
    ? `/preview/index.html?sample=${sample}`
    : "/preview/index.html";
---

<div class="demo-card not-content" data-component-demo>
    <div class="demo-toolbar">
        <div class="demo-tabs" role="tablist">
            <span class="demo-glider" data-glider aria-hidden="true"></span>
            <button
                type="button"
                class="demo-tab is-active"
                data-tab="preview"
                role="tab"
            >
                Preview
            </button>
            <button type="button" class="demo-tab" data-tab="code" role="tab">
                Code
            </button>
        </div>
        <div class="demo-actions">
            <span class="demo-file">{title}</span>
            <button type="button" class="demo-copy" data-copy>
                Copy
            </button>
        </div>
    </div>
    <div class="demo-preview" data-pane="preview" style={`height: ${height};`}>
        <div
            data-spinner
            style="position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; pointer-events: none;"
        >
            <p>Loading live preview…</p>
        </div>
        <iframe
            data-preview-frame
            src={src}
            title={`${title} live preview`}
            loading={eager ? "eager" : "lazy"}
            scrolling="auto"
        ></iframe>
    </div>
    <div
        class="demo-code"
        data-pane="code"
        style={`height: ${height}; overflow: auto;`}
        hidden
    >
        <slot />
    </div>
</div>

<script>
    const syncTheme = () => {
        const theme =
            document.documentElement.dataset.theme === "dark"
                ? "dark"
                : "light";
        document
            .querySelectorAll<HTMLIFrameElement>("[data-preview-frame]")
            .forEach((frame) => {
                try {
                    const url = new URL(frame.src, location.origin);
                    if (url.searchParams.get("theme") !== theme) {
                        url.searchParams.set("theme", theme);
                        frame.src = url.toString();
                    }
                } catch {
                    // src not yet resolvable; skip
                }
            });
    };

    const moveGlider = (root: Element) => {
        const active = root.querySelector<HTMLElement>("[data-tab].is-active");
        const glider = root.querySelector<HTMLElement>("[data-glider]");
        if (!active || !glider) return;
        glider.style.width = `${active.offsetWidth}px`;
        glider.style.transform = `translateX(${active.offsetLeft}px)`;
    };

    document.querySelectorAll("[data-component-demo]").forEach((root) => {
        const tabs = root.querySelectorAll<HTMLButtonElement>("[data-tab]");
        const panes = root.querySelectorAll<HTMLElement>("[data-pane]");
        tabs.forEach((tab) => {
            tab.addEventListener("click", () => {
                tabs.forEach((t) => t.classList.toggle("is-active", t === tab));
                panes.forEach((pane) => {
                    pane.hidden = pane.dataset.pane !== tab.dataset.tab;
                });
                moveGlider(root);
            });
        });
        moveGlider(root);

        const copyBtn = root.querySelector<HTMLButtonElement>("[data-copy]");
        copyBtn?.addEventListener("click", async () => {
            const code =
                root.querySelector("[data-pane='code'] pre code")
                    ?.textContent ?? "";
            if (!code) return;
            try {
                await navigator.clipboard.writeText(code);
            } catch {
                const ta = document.createElement("textarea");
                ta.value = code;
                document.body.appendChild(ta);
                ta.select();
                document.execCommand("copy");
                ta.remove();
            }
            const original = copyBtn.textContent;
            copyBtn.textContent = "Copied";
            setTimeout(() => (copyBtn.textContent = original), 1200);
        });

        const frame = root.querySelector<HTMLIFrameElement>(
            "[data-preview-frame]",
        );
        frame?.addEventListener(
            "load",
            () => root.querySelector("[data-spinner]")?.remove(),
            { once: true },
        );
    });
    window.addEventListener("resize", () => {
        document.querySelectorAll("[data-component-demo]").forEach(moveGlider);
    });

    syncTheme();
    new MutationObserver(syncTheme).observe(document.documentElement, {
        attributes: true,
        attributeFilter: ["data-theme"],
    });
</script>

<style>
    .demo-card {
        border: 1px solid var(--sl-color-gray-5);
        border-radius: 0.8rem;
        overflow: hidden;
        margin: 1rem 0;
        background: var(--kore-surface-bright);
    }
    .demo-toolbar {
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        gap: 0.9rem;
        padding: 0.8rem;
    }
    .demo-toolbar > * {
        align-self: center;
        margin-top: 0;
        margin-bottom: 0rem;
    }
    .demo-tabs {
        position: relative;
        display: flex;
        align-items: stretch;
        background: var(--sl-color-bg);
        border-radius: 0.9rem;
        padding: 0.2rem;
        gap: 0.2rem;
    }
    .demo-glider {
        position: absolute;
        top: 0.2rem;
        bottom: 0.2rem;
        left: 0;
        width: 0;
        border-radius: 0.8rem;
        background: var(--sl-color-gray-6);
        box-shadow: 0 1px 2px rgb(0 0 0 / 0.15);
        transition:
            transform 0.22s ease,
            width 0.22s ease;
    }
    .demo-tab {
        appearance: none;
        position: relative;
        z-index: 1;
        margin: 0;
        border: 0;
        background: transparent;
        color: var(--sl-color-gray-2);
        font-size: 0.8125rem;
        font-weight: 600;
        line-height: 1.4;
        padding: 0.2rem 0.8rem;
        border-radius: 0.8rem;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        align-self: stretch;
        flex: 0 0 auto;
    }
    .demo-tab.is-active {
        background: transparent;
        color: var(--sl-color-white);
    }
    .demo-actions {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        min-width: 0;
    }
    .demo-file {
        font-size: 0.75rem;
        color: var(--sl-color-gray-3);
        font-family: var(--sl-font-mono, monospace);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .demo-copy {
        border: 2px solid var(--sl-color-gray-5);
        background: transparent;
        color: var(--sl-color-gray-1);
        font-size: 0.75rem;
        font-weight: 600;
        padding: 0.2rem 0.8rem;
        border-radius: 1rem;
        cursor: pointer;
        flex-shrink: 0;
    }
    .demo-copy:hover {
        background: var(--sl-color-gray-6);
    }
    .demo-preview {
        position: relative;
        overflow: hidden;
    }
    .demo-preview iframe {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        border: 0;
        background: transparent;
    }
    . .demo-code :global(.expressive-code) {
        margin: 0;
    }
    .demo-code :global(pre) {
        margin: 0;
        border: 0;
        border-radius: 0;
        counter-reset: line;
    }
    .demo-code :global(.ec-line) {
        counter-increment: line;
    }
    .demo-code :global(.ec-line:hover) {
        background-color: var(--sl-color-gray-6);
    }
    .demo-code :global(.ec-line::before) {
        content: counter(line);
        display: inline-block;
        width: 2rem;
        flex-shrink: 0;
        margin-right: 1rem;
        text-align: right;
        color: var(--sl-color-gray-3);
        user-select: none;
    }
</style>
