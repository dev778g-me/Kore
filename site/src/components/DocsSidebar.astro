---
interface SidebarLink {
    type: "link";
    label: string;
    href: string;
    isCurrent: boolean;
}

interface SidebarGroup {
    type: "group";
    label: string;
    entries: SidebarItem[];
}

type SidebarItem = SidebarLink | SidebarGroup;

const { sidebar } = Astro.locals.starlightRoute;
---

<nav class="docs-nav" aria-label="Section navigation">
    {sidebar.map((entry) =>
        entry.type === "group" ? (
            <section class="docs-nav-section">
                <p class="docs-nav-title">{entry.label}</p>
                {entry.entries.map((child) =>
                    child.type === "link" ? (
                        <a
                            href={child.href}
                            aria-current={child.isCurrent ? "page" : undefined}
                            class:list={[
                                "docs-nav-link",
                                { "is-selected": child.isCurrent },
                            ]}
                        >
                            {child.label}
                        </a>
                    ) : (
                        <>
                            <p class="docs-nav-subtitle">{child.label}</p>
                            {child.entries.map((grandchild) =>
                                grandchild.type === "link" ? (
                                    <a
                                        href={grandchild.href}
                                        aria-current={
                                            grandchild.isCurrent
                                                ? "page"
                                                : undefined
                                        }
                                        class:list={[
                                            "docs-nav-link",
                                            "is-indented",
                                            {
                                                "is-selected":
                                                    grandchild.isCurrent,
                                            },
                                        ]}
                                    >
                                        {grandchild.label}
                                    </a>
                                ) : null,
                            )}
                        </>
                    ),
                )}
            </section>
        ) : (
            <a
                href={entry.href}
                aria-current={entry.isCurrent ? "page" : undefined}
                class:list={[
                    "docs-nav-link",
                    { "is-selected": entry.isCurrent },
                ]}
            >
                {entry.label}
            </a>
        ),
    )}
</nav>

<style>
    .docs-nav {
        background: var(--kore-background);
        border-radius: 0.8rem;
        padding: 0.125rem 0.5rem;
    }
    .docs-nav-section {
        padding: 0.125rem 0;
    }
    .docs-nav-title {
        font-size: 0.875rem;
        font-weight: 600;
        color: var(--kore-on-background);
        margin: 0;
        padding: 0.2;
    }
    .docs-nav-subtitle {
        font-size: 0.75rem;
        font-weight: 400;
        color: var(--kore-on-background);
        opacity: 0.9;
        margin: 0;
        padding: 0.75rem 0.5rem 0.25rem;
    }
    .docs-nav-link {
        display: block;
        width: 100%;
        box-sizing: border-box;
        margin: 0.25rem 0;
        padding: 0.2rem 0.8rem;
        border-radius: 0.6rem;
        font-size: 0.875rem;
        font-weight: 400;
        color: var(--kore-on-surface);
        text-decoration: none;
    }
    .docs-nav-link.is-indented {
        margin-left: 0.5rem;
        width: calc(100% - 0.5rem);
    }
    .docs-nav-link:hover {
        background: var(--sl-color-gray-4);
        color: var(--sl-color-text);
    }
    .docs-nav-link.is-selected {
        background: var(--kore-primary-container);
        color: var(--kore-on-primary-container);
        font-weight: 600;
    }
</style>
