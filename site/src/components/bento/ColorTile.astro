        const ROLES = [
            "neutral",
            "primary",
            "complementary",
            "error",
            "success",
        ];
        const TWS = [50, 100, 200, 300, 400, 500, 600, 700, 800, 900, 950];
        const HU = {
            rx: {
                neutral: ["gray", "mauve", "slate", "sage", "olive", "sand"],
                primary: ["blue", "indigo", "violet", "teal", "green", "pink"],
                complementary: ["orange", "amber", "pink", "violet", "teal"],
                error: ["red", "ruby", "crimson", "tomato"],
                success: ["green", "grass", "jade", "teal"],
            },
            tw: {
                neutral: ["slate", "gray", "zinc", "neutral", "stone"],
                primary: [
                    "blue",
                    "indigo",
                    "violet",
                    "teal",
                    "emerald",
                    "pink",
                ],
                complementary: ["orange", "amber", "pink", "violet", "teal"],
                error: ["red", "rose", "pink"],
                success: ["green", "emerald", "teal", "lime"],
            },
        };
        const ST = {
            rx: {
                neutral: "gray",
                primary: "blue",
                complementary: "orange",
                error: "red",
                success: "green",
            },
            tw: {
                neutral: "neutral",
                primary: "blue",
                complementary: "orange",
                error: "red",
                success: "green",
            },
        };

        let src = "rx";

        function sc(hue) {
            return (src === "rx" ? RX : TW)[hue];
        }

        function lum(hex) {
            const n = parseInt(hex, 16);
            return (
                (0.299 * ((n >> 16) & 255) +
                    0.587 * ((n >> 8) & 255) +
                    0.114 * (n & 255)) /
                255
            );
        }

        function stepName(i) {
            return src === "rx" ? i + 1 : TWS[i];
        }

        function cap(s) {
            return s.charAt(0).toUpperCase() + s.slice(1);
        }

        function kotlinColor(hex) {
            const raw = hex.replace("#", "").toUpperCase();
            return "Color(0x" + (raw.length === 6 ? "FF" + raw : raw) + ")";
        }

        function toast(text) {
            if (!ctoast) return;
            ctoast.textContent = text;
            ctoast.classList.add("on");
            clearTimeout(toast.timer);
            toast.timer = setTimeout(() => ctoast.classList.remove("on"), 1600);
        }

        function fillRole(role) {
            const el = croles.querySelector("#crole-" + role);
            if (!el) return;
            const hue = ST[src][role];
            const scale = sc(hue);
            const hn = el.querySelector(".kh-color-hn");
            if (hn) hn.textContent = hue;
            const huesEl = el.querySelector(".kh-color-hues");
            if (huesEl) {
                huesEl.innerHTML = HU[src][role]
                    .map((h) => {
                        const sw = sc(h);
                        const bg = sw ? "#" + sw[src === "rx" ? 8 : 5] : "#888";
                        return (
                            '<button type="button" style="background-color:' +
                            bg +
                            '" data-hue="' +
                            h +
                            '" aria-label="' +
                            h +
                            '" title="' +
                            h +
                            '" aria-pressed="' +
                            (h === hue) +
                            '"></button>'
                        );
                    })
                    .join("");
            }
            const scaleEl = el.querySelector(".kh-color-scale");
            if (scaleEl) {
                scaleEl.innerHTML = scale
                    .map((c, i) => {
                        const fg = lum(c) > 0.6 ? "#000" : "#fff";
                        const hoverFill = fg === "#000" ? "#fff" : "#000";
                        return (
                            '<button type="button" style="background:#' +
                            c +
                            ";color:" +
                            fg +
                            ";--hover-fill:" +
                            hoverFill +
                            ";--i:" +
                            i +
                            '" data-step="' +
                            stepName(i) +
                            '" data-hex="#' +
                            c +
                            '" aria-label="' +
                            role +
                            " " +
                            hue +
                            " " +
                            stepName(i) +
                            " #" +
                            c +
                            '"></button>'
                        );
                    })
                    .join("");
            }
        }

        function renderAll() {
            croles.innerHTML = ROLES.map((role) => {
                const pickable =
                    role === "neutral" ||
                    role === "primary" ||
                    role === "complementary";
                return (
                    '<div class="kh-color-role' +
                    (role === "neutral" ? " kh-color-role--wide" : "") +
                    '" id="crole-' +
                    role +
                    '">' +
                    '<div class="kh-color-rh"><b>' +
                    cap(role) +
                    '</b><span class="kh-color-hn"></span>' +
                    (pickable ? '<div class="kh-color-hues"></div>' : "") +
                    "</div>" +
                    '<div class="kh-color-scale"></div>' +
                    "</div>"
                );
            }).join("");
            ROLES.forEach(fillRole);
            if (ccount)
                ccount.textContent = src === "rx" ? "12 steps" : "11 steps";
            if (cread)
                cread.textContent =
                    "Hover a step, click to copy its Kotlin Color().";
        }

        croles.addEventListener("click", (e) => {
            const btn = e.target.closest("button");
            if (!btn) return;
            const roleEl = btn.closest(".kh-color-role");
            if (!roleEl) return;
            const role = roleEl.id.replace("crole-", "");
            if (btn.dataset.hue) {
                ST[src][role] = btn.dataset.hue;
                fillRole(role);
            } else if (btn.dataset.hex) {
                const value = kotlinColor(btn.dataset.hex);
                try {
                    navigator.clipboard.writeText(value);
                } catch (x) {}
                if (cread) cread.innerHTML = "Copied <b>" + value + "</b>";
                toast("Copied " + value);
            }
        });

        croles.addEventListener("pointerover", (e) => {
            const btn = e.target.closest("button[data-hex]");
            if (!btn) return;
            const roleEl = btn.closest(".kh-color-role");
            if (!roleEl) return;
            const role = roleEl.id.replace("crole-", "");
            if (cread)
                cread.innerHTML =
                    "<b>" +
                    cap(role) +
                    "</b> " +
                    ST[src][role] +
                    " " +
                    btn.dataset.step +
                    ", " +
                    kotlinColor(btn.dataset.hex);
        });

        croles.addEventListener("pointerleave", () => {
            if (cread)
                cread.textContent =
                    "Hover a step, click to copy its Kotlin Color().";
        });

        csrc.querySelectorAll("button").forEach((btn) => {
            btn.addEventListener("click", () => {
                csrc.querySelectorAll("button").forEach((b) =>
                    b.setAttribute("aria-pressed", String(b === btn)),
                );
                src = btn.dataset.src;
                renderAll();
            });
        });

        renderAll();
    }
</script>
