<article class="kh-tile kh-tile--color" data-tile data-color>
    <div class="kh-color-head">
        <span class="kh-eyebrow">Color scales</span>
        <div class="kh-seg" id="csrc" role="group" aria-label="Color source">
            <button type="button" data-src="rx" aria-pressed="true">
                Radix
            </button>
            <button type="button" data-src="tw" aria-pressed="false">
                Tailwind
            </button>
        </div>
    </div>
    <p class="kh-color-lead">
        Kore provides full Radix and Tailwind scales,{" "}
        <span id="ccount">12 steps</span> per hue. Pick a hue for each role and
        copy any step.
    </p>
    <div class="kh-color-roles" id="croles"></div>
    <div class="kh-color-foot">
        <span class="kh-color-read" id="cread">
            Hover a step, click to copy its Kotlin Color().
        </span>
    </div>
    <div class="kh-toast" id="ctoast" role="status"></div>
</article>

<style is:global>
    .kh-color-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
    }

    .kh-seg {
        display: inline-flex;
        gap: 0.15rem;
        padding: 0.2rem;
        border: 0;
        border-radius: 999px;
        background: var(--kore-surface);
    }

    .kh-seg button {
        height: auto;
        padding: 0.28rem 0.75rem;
        border: 0;
        border-radius: 999px;
        appearance: none;
        -webkit-appearance: none;
        font: inherit;
        font-size: 0.74rem;
        font-weight: 500;
        color: var(--kore-on-background-variant);
        background: transparent;
        cursor: pointer;
        transition:
            background 0.2s,
            color 0.2s;
    }

    .kh-seg button:hover {
        color: var(--kore-on-background);
    }

    .kh-seg button:focus-visible {
        outline: 2px solid var(--kore-primary);
        outline-offset: 2px;
    }

    .kh-seg button[aria-pressed="true"] {
        background: var(--kore-surface-bright);
        color: var(--kore-on-background);
        font-weight: 600;
    }

    .kh-color-lead {
        margin: 0;
        font-size: 0.8rem;
        line-height: 1.45;
        color: var(--kore-on-background-variant);
    }

    .kh-color-roles {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 2rem;
        margin-top: auto;
    }

    .kh-color-role {
        display: grid;
        gap: 0.3rem;
        min-width: 0;
    }

    .kh-color-role--wide {
        grid-column: 1 / -1;
    }

    .kh-color-rh {
        display: flex;
        align-items: center;
        gap: 0.2rem;
        min-width: 0;
        font-size: 0.72rem;
    }

    .kh-color-rh b {
        flex: none;
        font-weight: 600;
    }

    .kh-color-rh .kh-color-hn {
        min-width: 0;
        overflow: hidden;
        color: var(--kore-on-background-variant);
        font-size: 0.68rem;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .kh-color-hues {
        display: flex;
        flex: none;
        padding-bottom: 1rem;
        gap: 0.4rem;
        margin-left: auto;
    }

    .kh-color-hues button {
        width: 0.9rem;
        height: 0.9rem;
        border: 0;
        border-radius: 999px;
        transition:
            transform 0.2s var(--ease),
            outline-color 0.2s var(--ease);
    }

    .kh-color-hues button:hover {
        transform: scale(1.15);
    }

    .kh-color-hues button[aria-pressed="true"] {
        outline: 2px solid var(--kore-on-background);
        outline-offset: 0;
    }

    .kh-color-scale {
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        gap: 4px;
        min-width: 0;
    }

    .kh-color-scale button {
        position: relative;
        min-width: 0;
        aspect-ratio: 1;
        align-self: start;
        padding: 0;
        border: 0;
        border-radius: 0.25rem;
        cursor: pointer;
        font: inherit;
        font-size: 0.58rem;
        line-height: 1;
        font-weight: 600;
        color: inherit;
        display: grid;
        place-items: center;
        animation: kh-step-in 0.4s var(--ease) both;
        animation-delay: calc(var(--i) * 22ms);
    }

    @keyframes kh-step-in {
        from {
            opacity: 0;
        }
    }

    .kh-color-scale button::before {
        content: "";
        position: absolute;
        inset: 0;
        border-radius: inherit;
        background: var(--hover-fill, currentColor);
        opacity: 0;
        transition: opacity 0.18s var(--ease);
    }

    .kh-color-scale button::after {
        content: attr(data-step);
        position: relative;
        z-index: 1;
        opacity: 0;
        transform: translateY(3px);
        transition:
            opacity 0.18s var(--ease),
            transform 0.18s var(--ease);
    }

    .kh-color-scale button:hover::before {
        opacity: 0.14;
    }

    .kh-color-scale button:hover::after {
        opacity: 1;
        transform: none;
    }

    .kh-color-foot {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 0.6rem;
        min-height: 1.25rem;
        font-size: 0.72rem;
        color: var(--kore-on-background-variant);
    }

    .kh-color-read {
        min-width: 0;
    }

    .kh-color-read b {
        color: var(--kore-on-background);
        font-weight: 600;
    }

    .kh-toast {
        position: fixed;
        left: 50%;
        bottom: 1.5rem;
        z-index: 100;
        transform: translate(-50%, 120px);
        background: var(--kore-on-background);
        color: var(--kore-background);
        padding: 0.7rem 1.15rem;
        border-radius: 99px;
        font-size: 0.85rem;
        font-weight: 500;
        pointer-events: none;
        transition: transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .kh-toast.on {
        transform: translate(-50%, 0);
    }

    @media (max-width: 36rem) {
        .kh-color-roles {
            grid-template-columns: minmax(0, 1fr);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .kh-color-scale button {
            animation: none;
        }
        .kh-color-hues button,
        .kh-color-scale button,
        .kh-toast {
            transition: none;
        }
    }
</style>

